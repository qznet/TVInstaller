<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:orientation="vertical"
    android:padding="@dimen/page_padding">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/fileTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="文件列表"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/title_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/pathText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:singleLine="true"
                android:text="smb://"
                android:textColor="@color/text_muted"
                android:textSize="@dimen/sub_text" />
        </LinearLayout>

        <Button
            android:id="@+id/backParentButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:background="@drawable/bg_button_secondary"
            android:focusable="true"
            android:minWidth="110dp"
            android:text="@string/back_parent"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text" />

        <Button
            android:id="@+id/clearCredentialButton"
            android:layout_width="wrap_content"
            android:layout_height="46dp"
            android:layout_marginLeft="@dimen/page_gap"
            android:layout_marginStart="@dimen/page_gap"
            android:background="@drawable/bg_button_secondary"
            android:focusable="true"
            android:minWidth="110dp"
            android:text="@string/clear_credentials"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/button_text" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/loadingBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="@dimen/page_gap"
        android:indeterminate="true"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/fileRecycler"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/page_gap"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:focusable="true" />

    <Button
        android:id="@+id/loadMoreButton"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="@dimen/page_gap"
        android:background="@drawable/bg_button_primary"
        android:focusable="true"
        android:text="@string/load_more"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/button_text"
        android:visibility="gone" />
</LinearLayout>

