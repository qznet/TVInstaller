<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowBackground">@color/bg_app</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="colorAccent">@color/focus</item>
    </style>

    <style name="Widget.GithubTv.Button" parent="">
        <item name="android:layout_height">@dimen/button_height</item>
        <item name="android:minWidth">@dimen/button_min_width</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:paddingLeft">@dimen/button_padding_horizontal</item>
        <item name="android:paddingRight">@dimen/button_padding_horizontal</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textSize">@dimen/body_text</item>
        <item name="android:gravity">center</item>
        <item name="android:focusable">true</item>
        <item name="android:focusableInTouchMode">true</item>
        <item name="android:clickable">true</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:background">@drawable/bg_button_secondary</item>
    </style>

    <style name="Widget.GithubTv.Button.Primary" parent="Widget.GithubTv.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
    </style>

    <style name="Widget.GithubTv.Button.Compact" parent="Widget.GithubTv.Button">
        <item name="android:minWidth">68dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:textSize">@dimen/hint_text</item>
    </style>

    <style name="Text.GithubTv.Title" parent="">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/text_bright</item>
        <item name="android:textSize">@dimen/title_text</item>
        <item name="android:textStyle">bold</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Text.GithubTv.Hint" parent="">
        <item name="android:fontFamily">sans</item>
        <item name="android:textColor">@color/text_secondary</item>
        <item name="android:textSize">@dimen/hint_text</item>
        <item name="android:includeFontPadding">false</item>
    </style>
</resources>
