<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_app"
    android:padding="6dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_shell"
        android:orientation="vertical"
        android:paddingLeft="@dimen/page_padding_horizontal"
        android:paddingTop="@dimen/page_padding_vertical"
        android:paddingRight="@dimen/page_padding_horizontal"
        android:paddingBottom="@dimen/page_padding_vertical">

        <!-- Header: app identity plus a compact, non-interactive remote guide. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/header_height"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/titleText"
                    style="@style/Text.GithubTv.Title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/header_title" />

                <TextView
                    style="@style/Text.GithubTv.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="@string/header_subtitle"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/subtitle_text" />
            </LinearLayout>

            <TextView
                style="@style/Text.GithubTv.Hint"
                android:layout_width="300dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_remote_hint"
                android:gravity="end|center_vertical"
                android:maxLines="2"
                android:text="@string/remote_header_hint" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border" />

        <!-- 30/70 split from the prototype. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/section_gap"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/content_gap"
                android:layout_weight="3"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="@dimen/panel_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/toolbar_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/syncButton"
                        style="@style/Widget.GithubTv.Button.Primary"
                        android:layout_width="wrap_content"
                        android:nextFocusRight="@id/favoriteButton"
                        android:text="@string/sync" />

                    <Button
                        android:id="@+id/favoriteButton"
                        style="@style/Widget.GithubTv.Button"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:nextFocusLeft="@id/syncButton"
                        android:nextFocusRight="@id/browserHomeButton"
                        android:text="@string/favorite" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/presetCountText"
                        style="@style/Text.GithubTv.Hint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_badge"
                        android:text="@string/preset_badge"
                        android:textColor="@color/text_muted" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/border" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/repoRecycler"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_marginTop="4dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:descendantFocusability="afterDescendants"
                    android:focusable="false"
                    android:paddingBottom="4dp"
                    android:scrollbars="vertical" />

                <TextView
                    style="@style/Text.GithubTv.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:paddingTop="4dp"
                    android:text="@string/repository_list_hint"
                    android:textColor="@color/text_muted" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="7"
                android:background="@drawable/bg_panel"
                android:orientation="vertical"
                android:padding="@dimen/panel_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/toolbar_height"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/browserUrlText"
                        style="@style/Text.GithubTv.Hint"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_url"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="@string/default_repository_url" />

                    <Button
                        android:id="@+id/browserHomeButton"
                        style="@style/Widget.GithubTv.Button.Compact"
                        android:layout_width="wrap_content"
                        android:nextFocusLeft="@id/favoriteButton"
                        android:nextFocusRight="@id/browserBackButton"
                        android:text="@string/repository_list" />

                    <Button
                        android:id="@+id/browserBackButton"
                        style="@style/Widget.GithubTv.Button.Compact"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:nextFocusLeft="@id/browserHomeButton"
                        android:nextFocusRight="@id/browserRefreshButton"
                        android:text="@string/back" />

                    <Button
                        android:id="@+id/browserRefreshButton"
                        style="@style/Widget.GithubTv.Button.Compact"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="8dp"
                        android:nextFocusLeft="@id/browserBackButton"
                        android:text="@string/refresh" />
                </LinearLayout>

                <FrameLayout
                    android:id="@+id/webContainer"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_webview_focus"
                    android:padding="@dimen/web_focus_inset">

                    <WebView
                        android:id="@+id/webView"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@color/browser_background"
                        android:focusable="true"
                        android:focusableInTouchMode="true" />

                    <ProgressBar
                        android:id="@+id/webProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/progress_height"
                        android:layout_gravity="top"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_horizontal"
                        android:visibility="gone" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/downloadPanel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_download_panel"
                    android:contentDescription="@string/download_panel_content_description"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/downloadStatusText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:text="@string/download_idle"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/hint_text" />

                    <ProgressBar
                        android:id="@+id/downloadProgress"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/progress_height"
                        android:layout_marginTop="8dp"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@drawable/progress_horizontal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</FrameLayout>
